{
  "dynamic": "strict",
  "properties": {
    "id": {
      "type": "keyword"
    },
    "version": {
      "type": "long"
    },
    "homeOrganisationTkCode": {
      "type": "keyword"
    },
    "statuses": {
      "type": "nested",
      "properties": {
        "organisationId": {
          "type": "keyword"
        },
        "status": {
          "type": "keyword"
        },
        "rejectionReason": {
          "properties": {
            "values": {
              "properties": {
                "fi": {
                  "type": "text",
                  "copy_to": "search_fi"
                },
                "en": {
                  "type": "text",
                  "copy_to": "search_en"
                },
                "sv": {
                  "type": "text",
                  "copy_to": "search_sv"
                }
              }
            }
          }
        }
      }
    },
    "timestamp": {
      "type": "date",
      "format": "uuuu-MM-dd'T'HH:mm:ss.SSSXXX"
    },
    "homeStudyRight": {
      "properties": {
        "identifiers": {
          "properties": {
            "organisationTkCodeReference": {
              "type": "keyword"
            },
            "studyRightId": {
              "type": "keyword"
            }
          }
        },
        "studyRightStatus": {
          "properties": {
            "studyRightStatusValue": {
              "type": "integer"
            },
            "startDate": {
              "type": "date"
            },
            "endDate": {
              "type": "date"
            }
          }
        },
        "studyRightType": {
          "type": "keyword"
        },
        "eligibleForNetworkStudies": {
          "type": "boolean"
        }
      }
    },
    "messageType": {
      "type": "keyword"
    },
    "search_fi": {
      "type": "text",
      "analyzer": "finnish"
    },
    "search_en": {
      "type": "text",
      "analyzer": "english"
    },
    "search_sv": {
      "type": "text",
      "analyzer": "swedish"
    }
  }
}
